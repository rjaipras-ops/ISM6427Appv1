# Copy to .env for local development (never commit .env).
# In production, set these in Netlify: Site configuration → Environment variables.

# Flexmls Spark Datamart WebAPI access token. Leave empty to run in test (mock) mode.
SPARK_API_BEARER_TOKEN=

# RESO Web API (recommended):   https://replication.sparkapi.com/Reso/OData
# Spark REST API:                https://replication.sparkapi.com/v1
# Replication-role keys use replication.sparkapi.com; IDX-role keys are usually issued for
# sparkapi.com (e.g. https://sparkapi.com/Reso/OData). Use the host your key was issued for.
SPARK_API_BASE_URL=https://replication.sparkapi.com/Reso/OData
SPARK_USER_AGENT=BeachesMLS_IDX_Client/1.0

# How often to pull changed listings and photos (minutes).
IDX_SYNC_INTERVAL_MINUTES=15

# Secret for POST /api/idx/sync (send "Authorization: Bearer <secret>"). Empty = manual sync disabled.
IDX_SYNC_SECRET=

# Optional tuning
# IDX_COUNTIES=Broward,Palm Beach,St. Lucie     # CountyOrParish values exactly as the MLS spells them
# IDX_PROPERTY_TYPES=Residential
# IDX_PAGE_SIZE=200                              # RESO $top per page (Spark REST caps at 25)
# IDX_RECONCILE_HOURS=24                         # full check for deleted/opted-out listings
# IDX_SHOW_OWNER=false                           # BeachesMLS rule 20.3.8: keep false unless BeachesMLS approves in writing

# Only for `npm run idx:sync` against your live Netlify storage:
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
